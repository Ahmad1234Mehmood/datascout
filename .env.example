# Copy to .env (never commit .env). Real environment variables override this file.

# heuristic = rule-based, no LLM (default) | ollama | openai | anthropic
DATASCOUT_LLM_PROVIDER=heuristic
DATASCOUT_LLM_MODEL=qwen2.5:7b

# --- ollama: local, or a Kaggle/Colab notebook exposed through a tunnel (see README) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- openai-compatible hosted APIs: set provider=openai, then ---
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=

# --- optional Langfuse tracing ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# DATASCOUT_MAX_UPLOAD_MB=25
# DATASCOUT_DATA_DIR=./data
